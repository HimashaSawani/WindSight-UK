WINDSIGHT_FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080
WINDSIGHT_ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
WINDSIGHT_ELEXON_TIMEOUT_SECONDS=30
WINDSIGHT_ELEXON_MAX_RETRIES=3
WINDSIGHT_CACHE_DIR=.cache/elexon
WINDSIGHT_CACHE_TTL_SECONDS=900
WINDSIGHT_CACHE_REFRESH=false
WINDSIGHT_INGESTION_ENABLED=false
WINDSIGHT_INGESTION_INTERVAL_SECONDS=3600
WINDSIGHT_INGESTION_LOOKBACK_DAYS=2
WINDSIGHT_INGESTION_FORECAST_OVERLAP_HOURS=6
WINDSIGHT_INGESTION_STORE_PATH=.data/windsight/ingestion.json
# Required to enable POST /api/admin/ingestion/sync. Keep this secret outside source control.
WINDSIGHT_INGESTION_ADMIN_TOKEN=
WINDSIGHT_DECISION_CUTOFF_LOCAL_TIME=12:00:00
WINDSIGHT_FORECAST_PUBLICATION_LOOKBACK_DAYS=31
